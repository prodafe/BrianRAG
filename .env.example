# BrianRAG 环境变量配置
# 复制此文件为 .env 并修改对应值
# 所有变量都有默认值，未设置时使用 config.py 中的默认值

# ── 数据库 ──
# BRIAN_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
# BRIAN_REDIS_URL=redis://localhost:6379/0

# ── 模型路径 ──
# BRIAN_RERANK_MODEL=D:/reranker/bge-reranker-v2-m3
# BRIAN_CLIP_MODEL=D:/models/sentence-transformers/clip-ViT-B-32

# ── LLM 提供商 ──
# BRIAN_LLM_PROVIDER=ollama     # ollama | openai | anthropic
# BRIAN_LLM_API_KEY=            # OpenAI / Anthropic 的 API Key

# ── GitHub 数据源 ──
# BRIAN_GITHUB_REPO_URL=https://github.com/user/repo.git
# BRIAN_GITHUB_BRANCH=master
# BRIAN_GITHUB_TOKEN=ghp_xxxxxxxxxxxx
